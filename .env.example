# Alpaca — the hackathon's dedicated, brand-new paper account. Never point
# this at trading_bot/'s account; a reused account is disqualified from
# judging per the hackathon rules.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# LLM reasoning step (llm_reasoner.py) — defaults to the user's own
# flat-rate mimo-v2.5-pro plan (zero marginal cost, proven reliable
# elsewhere in their infra). See llm_reasoner.py's module docstring for why
# a free OpenRouter model was tried and rejected (reliability, not cost).
REASONER_API_BASE=https://token-plan-ams.xiaomimimo.com/v1
REASONER_API_KEY=
REASONER_MODEL=mimo-v2.5-pro

# Supabase — same project as Agent Bazaar, isolated in its own schema
# (alpaca_hackathon), reached via direct Postgres (see db.py for why, not
# the REST API).
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_SCHEMA=alpaca_hackathon

# Risk gates — defaults in config.py, override here only if you have a
# specific reason to (see config.py's comments for the reasoning behind
# each default, incl. the 2026-08-26 research pass that set most of these).
# MAX_LOSS_PER_SPREAD_PCT=0.02
# MAX_DAILY_LOSS_PCT=0.03
# MAX_CONCURRENT_SPREADS=5
# MIN_DTE=10
# MAX_DTE=21
# SHORT_LEG_TARGET_DELTA=0.17  -- an 2026-08-27 backtest pass initially
#   suggested bumping this to 0.20, but verify_backtest.py found the
#   strike-rounding proxy's own error (up to ~60% relative delta miss for
#   lower-priced names) swamps that difference -- reverted, stayed at
#   0.17. See README's "Parameter optimization pass" section.
# SPREAD_WIDTH_DOLLARS=5.0
# PROFIT_TARGET_PCT=0.50
# STOP_LOSS_MULTIPLE=2.0
# MIN_OPEN_INTEREST=100
# MAX_BID_ASK_SPREAD_PCT=0.12
# CONTEST_END_UTC=2026-09-04T15:00:00+00:00

# Realized-volatility-percentile filter (proxy for true IV rank — see
# config.VolatilityFilter's docstring).
# VOL_FILTER_ENABLED=true
# VOL_LOOKBACK_ATR_WINDOW=20
# VOL_MIN_PERCENTILE=0.40
